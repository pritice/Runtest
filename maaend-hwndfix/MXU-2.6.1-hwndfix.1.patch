@@ -0,0 +1,4 @@
+/** Local HWND repair builds must not silently replace themselves with an unfixed release. */
+export function allowsAutomaticUpdates(mxuVersion: string | undefined): boolean {
+  return !/-hwndfix(?:[.+-]|$)/.test(mxuVersion ?? '');
+}
