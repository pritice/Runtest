+++ b/tests/update-policy.test.mjs
@@ -0,0 +1,15 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { allowsAutomaticUpdates } from '../src/utils/updatePolicy.ts';
+
+test('HWND repair builds cannot silently overwrite their repair', () => {
+  for (const version of ['2.6.1-hwndfix.1', 'v2.6.1-hwndfix.2+local', '2.6.1-hwndfix']) {
+    assert.equal(allowsAutomaticUpdates(version), false);
+  }
+});
+
+test('official stable and preview builds keep their automatic update behavior', () => {
+  for (const version of [undefined, '2.6.1', '2.7.0-beta.1', '2.7.0-rc.1', '2.6.1+hwndfix']) {
+    assert.equal(allowsAutomaticUpdates(version), true);
+  }
+});
