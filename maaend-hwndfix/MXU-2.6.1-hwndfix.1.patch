+/// Keep Windows HWNDs exact when serialized through JavaScript's Number type.
+/// Windows user-object handles have only 32 significant bits, but an HWND can
+/// arrive sign-extended on 64-bit Windows. Sending that u64 to JavaScript would
+/// lose low bits before the handle is passed back to the controller.
+fn desktop_window_handle_for_frontend(handle: u64) -> u64 {
+    #[cfg(windows)]
+    {
+        u64::from(handle as u32)
+    }
+    #[cfg(not(windows))]
+    {
+        handle
+    }
+}
 
