@@ -0,0 +1,33 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+
+// Exercise the actual JavaScript/JSON boundary without external dependencies.
+// These supplement, but do not replace, the Rust tests in maa_core.rs.
+const signExtendedHandles = [
+  0xffff_ffff_8000_0001n,
+  0xffff_ffff_db88_1daen,
+  0xffff_ffff_ffff_fffen,
+];
+const low32Mask = 0xffff_ffffn;
+
+for (const nativeHandle of signExtendedHandles) {
+  test(`JSON preserves HWND ${nativeHandle.toString(16)} after backend normalization`, () => {
+    const oldWindow = JSON.parse(`{"handle":${nativeHandle},"class_name":"UnityWndClass","window_name":"Endfield"}`);
+    const oldRequest = JSON.parse(JSON.stringify({ type: 'Win32', handle: oldWindow.handle }));
+    assert.notEqual(BigInt(oldRequest.handle) & low32Mask, nativeHandle & low32Mask);
+
+    const normalizedHandle = nativeHandle & low32Mask;
+    const fixedWindow = JSON.parse(`{"handle":${normalizedHandle},"class_name":"UnityWndClass","window_name":"Endfield"}`);
+    const fixedRequest = JSON.parse(JSON.stringify({ type: 'Win32', handle: fixedWindow.handle }));
+    assert.equal(typeof fixedRequest.handle, 'number');
+    assert.ok(Number.isSafeInteger(fixedRequest.handle));
+    assert.equal(BigInt(fixedRequest.handle), normalizedHandle);
+  });
+}
+
+test('existing handles and the full unsigned 32-bit boundary remain exact', () => {
+  for (const handle of [0n, 1n, 1447842n, 439029706n, 0x7fff_ffffn, 0x8000_0000n, 0xffff_ffffn]) {
+    const request = JSON.parse(`{"handle":${handle & low32Mask}}`);
+    assert.equal(BigInt(request.handle), handle);
+  }
+});
