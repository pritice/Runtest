+[CmdletBinding()]
+param()
+$ErrorActionPreference = 'Stop'
+$buildRoot = $PSScriptRoot
+$targetTriple = 'x86_64-pc-windows-msvc'
+$fixVersion = '2.5.3-hwndfix.1'
+
+function Invoke-Checked {
+    param([string]$Program, [string[]]$Arguments)
+    & $Program @Arguments
+    if ($LASTEXITCODE -ne 0) { throw "$Program failed with exit code $LASTEXITCODE." }
+}
+
+Push-Location $buildRoot
+try {
+    foreach ($program in @('node', 'pnpm', 'rustc', 'cargo')) {
+        if (-not (Get-Command $program -ErrorAction SilentlyContinue)) {
+            throw "Missing $program. See README-HWNDFIX.md. No executable has been built."
+        }
+    }
+    if ((node -p 'process.platform') -ne 'win32') { throw 'Run this script on Windows.' }
+    Invoke-Checked 'node' @('-e', 'const [major, minor] = process.versions.node.split(".").map(Number); if (!(major === 20 && minor >= 19 || major === 22 && minor >= 12 || major > 22)) { console.error("Node.js 20.19+ or 22.12+ is required."); process.exit(1); }')
+    if ((pnpm --version) -notmatch '^10\.28\.0$') { throw 'Use pnpm 10.28.0, as pinned in package.json.' }
+    Invoke-Checked 'node' @('--test', 'tests/hwnd-json-regression.test.mjs')
+    Invoke-Checked 'pnpm' @('install', '--frozen-lockfile')
+    Invoke-Checked 'cargo' @('fmt', '--manifest-path', 'src-tauri/Cargo.toml', '--', '--check')
+    Invoke-Checked 'pnpm' @('tauri', 'build', '--no-bundle', '--target', $targetTriple, '--', '--locked')
+    Invoke-Checked 'cargo' @('test', '--release', '--locked', '--manifest-path', 'src-tauri/Cargo.toml', '--target', $targetTriple, '--lib', 'window_handle')
+
+    $exe = Join-Path $buildRoot "src-tauri\target\$targetTriple\release\mxu.exe"
+    if (-not (Test-Path -LiteralPath $exe)) { throw 'Build finished without mxu.exe.' }
+    $packageName = "MaaEnd-MXU-$fixVersion-win-x86_64"
+    $artifactRoot = Join-Path $buildRoot 'artifacts'
+    $packageDir = Join-Path $artifactRoot $packageName
+    New-Item -ItemType Directory -Path $packageDir -Force | Out-Null
+    Copy-Item -LiteralPath $exe -Destination (Join-Path $packageDir 'MaaEnd.exe')
+    Copy-Item -LiteralPath 'LICENSE', 'README-HWNDFIX.md' -Destination $packageDir
+    $packageReadme = Join-Path $packageDir 'README-HWNDFIX.md'
+    $readmeText = Get-Content -LiteralPath $packageReadme -Raw -Encoding utf8
+    $readmeText = $readmeText -replace '(?s)## Status\r?\n.*?(?=## Fix)', "## Status`n`nThis package was produced after the JavaScript regressions, Rust formatting check, Windows x86_64 release build and Windows HWND Rust regressions completed successfully. The real game connection and screenshot smoke test has not been run on this binary. See BUILD-VALIDATION.json for the build record.`n`n"
+    Set-Content -LiteralPath $packageReadme -Value $readmeText -Encoding utf8
+    $sourceEntries = @('src', 'src-tauri', 'public', 'tests', 'package.json', 'pnpm-lock.yaml', 'index.html', 'vite.config.ts', 'tsconfig.json', 'tsconfig.node.json', 'Build-Windows-HwndFix.ps1', 'README-HWNDFIX.md', 'LICENSE')
+    # Exclude generated code, build outputs and dependencies from corresponding source.
+    $sourceStage = Join-Path $artifactRoot ('source-' + (Get-Date -Format 'yyyyMMddHHmmss'))
+    New-Item -ItemType Directory -Path $sourceStage -Force | Out-Null
+    foreach ($entry in $sourceEntries) {
+        if ($entry -eq 'src-tauri') {
+            New-Item -ItemType Directory -Path (Join-Path $sourceStage 'src-tauri') -Force | Out-Null
+            Get-ChildItem -LiteralPath 'src-tauri' -Force | Where-Object Name -notin @('target', 'gen') | Copy-Item -Destination (Join-Path $sourceStage 'src-tauri') -Recurse
+        } else { Copy-Item -LiteralPath $entry -Destination $sourceStage -Recurse }
+    }
+    Compress-Archive -Path (Join-Path $sourceStage '*') -DestinationPath (Join-Path $packageDir 'corresponding-source.zip') -Force
+    $hash = (Get-FileHash -LiteralPath (Join-Path $packageDir 'MaaEnd.exe') -Algorithm SHA256).Hash
+    "$hash  MaaEnd.exe" | Set-Content -LiteralPath (Join-Path $packageDir 'SHA256SUMS.txt') -Encoding ascii
+    $validation = [ordered]@{
+        version = $fixVersion
+        target = $targetTriple
+        built_at_utc = (Get-Date).ToUniversalTime().ToString('o')
+        javascript_regressions = 'passed'
+        rust_format = 'passed'
+        windows_release_build = 'passed'
+        windows_hwnd_rust_regressions = 'passed'
+        real_game_smoke_test = 'not_run'
+        executable_sha256 = $hash
+        rustc = (rustc --version)
+        node = (node --version)
+        pnpm = (pnpm --version)
+        github_run_id = $env:GITHUB_RUN_ID
+        github_commit = $env:GITHUB_SHA
+    }
+    $validation | ConvertTo-Json | Set-Content -LiteralPath (Join-Path $packageDir 'BUILD-VALIDATION.json') -Encoding utf8
+    $packagePath = Join-Path $artifactRoot ($packageName + '.zip')
+    Compress-Archive -Path (Join-Path $packageDir '*') -DestinationPath $packagePath -Force
+    Write-Output "Built: $packagePath"
+    Write-Output 'Before installation, perform a real game connection and screenshot smoke test.'
+} finally { Pop-Location }
